# Environment Configuration
NODE_ENV=production
PORT=5000
CLIENT_URL=https://your-client-app.vercel.app
SERVER_URL=https://your-server-api.onrender.com

# Database (MongoDB Atlas Replica Set Connection URI)
DATABASE_URL="mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/event_photo_gallery?retryWrites=true&w=majority"

# Authentication & Session Security (Min 32 random characters)
JWT_SECRET=replace_with_a_secure_random_string_at_least_32_chars_long
JWT_EXPIRES_IN=7d
GALLERY_SESSION_SECRET=replace_with_another_secure_random_string_min_32_chars

# AWS S3 Storage (Backend Only - Never expose on client)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_iam_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_iam_secret_access_key
AWS_S3_BUCKET=your-production-bucket-name

# Upload Constraints
MAX_FILE_SIZE=52428800

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
PIN_RATE_LIMIT_MAX=5
