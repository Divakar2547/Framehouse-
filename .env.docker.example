# ─────────────────────────────────────────────────────────────────────────────
# Framehouse — Docker local development environment
#
# Copy this file to server/.env before running docker compose:
#   cp .env.docker.example server/.env
#
# The DATABASE_URL is overridden inside docker-compose.yml to point at the
# compose mongo service, so you do NOT need to change it here for local dev.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:5000

# Overridden by docker-compose.yml — leave as-is for local docker dev
DATABASE_URL="mongodb://mongo:27017/framehouse_dev?replicaSet=rs0&directConnection=true"

# Change these to strong random strings (32+ chars) in any shared environment
JWT_SECRET=local-docker-jwt-secret-change-me-to-something-random-32chars
JWT_EXPIRES_IN=7d
GALLERY_SESSION_SECRET=local-docker-gallery-session-secret-32-chars-here

# AWS S3 — leave empty to use local disk mock storage (no AWS account needed)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

# Upload & rate limiting
MAX_FILE_SIZE=52428800
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
PIN_RATE_LIMIT_MAX=5
